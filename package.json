{
  "name": "@nyuchi/mzizi-console",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "app.mzizi.dev \u2014 the Mzizi console. Astro in front, Rust/Dioxus islands behind.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm run build:wasm && vp run astro:build",
    "build:wasm": "bash scripts/build-island.sh",
    "astro:build": "astro build",
    "dev": "astro dev",
    "check": "pnpm run check:web && pnpm run check:rust",
    "check:web": "astro check && vp check",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --all-targets -- -D warnings && cargo check --target wasm32-unknown-unknown --all-targets",
    "test": "cargo test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "ci:prepare": "astro sync",
    "ci:test": "vp test --passWithNoTests",
    "ci:build": "vp run astro:build"
  },
  "devDependencies": {
    "@astrojs/check": ">=0.9.12",
    "@types/node": ">=24.19.1",
    "astro": ">=7.4.2",
    "prettier-plugin-astro": ">=0.14.1",
    "typescript": ">=5.9.3",
    "vite-plus": ">=1.4.0"
  },
  "dependencies": {
    "@workos-inc/authkit-js": ">=0.20.4"
  },
  "pnpm": {
    "overrides": {
      "devalue@<5.9.3": ">=5.9.3",
      "http-cache-semantics@<4.3.0": ">=4.3.0",
      "sharp@<0.35.5": ">=0.35.5",
      "source-map-js@<1.2.2": ">=1.2.2",
      "undici@>=8.0.0 <8.12.2": ">=8.12.2",
      "vite@>=8.0.0 <8.3.5": ">=8.3.5",
      "zod@<4.6.6": ">=4.6.6"
    }
  }
}
